[Unit]
Description=HyperFlux Next V2 device keeper
Documentation=man:hyperfluxctl(1)
# The bridge starts it, and listens on the socket it connects to.
After=systemd-udevd.service hyperflux-next-bridge.service
# It holds the virtual devices, so like the bridge it stops after user
# sessions: openrazer-daemon is gone before the devices disappear.
Before=systemd-user-sessions.service

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30s
User=hyperflux-keeper
Group=hyperflux
SupplementaryGroups=hyperflux-keeper
ExecStart=/usr/lib/hyperflux-next/hyperflux-next-keeper
UMask=0077
Restart=on-failure
RestartSec=2s
TimeoutStartSec=15s
TimeoutStopSec=10s
LimitNOFILE=256
TasksMax=32

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
# Reading the receiver's interfaces 0 and 1, and making the battery and
# OpenRazer virtual devices.
DevicePolicy=closed
DeviceAllow=char-hidraw r
DeviceAllow=/dev/uhid rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
# AF_NETLINK for udev's messages about receivers coming and going. No IP.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @privileged @resources
RemoveIPC=yes
# The keeper unbinds OpenRazer from its own virtual devices before it
# destroys them. Drivers that aren't loaded at start are skipped.
ReadWritePaths=-/sys/bus/hid/drivers/razeraccessory/unbind -/sys/bus/hid/drivers/razerkbd/unbind
ReadWritePaths=-/sys/bus/hid/drivers/razerkraken/unbind -/sys/bus/hid/drivers/razermouse/unbind
