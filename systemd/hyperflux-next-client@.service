[Unit]
Description=HyperFlux Next V2 desktop proxy for UID %i
Documentation=man:hyperfluxctl(1)
PartOf=user-runtime-dir@%i.service
Requires=hyperflux-next-client@%i.socket hyperflux-next-bridge.service
After=hyperflux-next-client@%i.socket hyperflux-next-bridge.service

[Service]
Type=simple
# The user's own uid with the hyperflux group: enough to reach the system
# socket, and the user never needs to join the group.
User=%i
Group=hyperflux
ExecStart=/usr/lib/systemd/systemd-socket-proxyd /run/hyperflux-next/bridge.sock
UMask=0077
TimeoutStartSec=10s
TimeoutStopSec=10s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @module @raw-io @reboot @swap
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/run/hyperflux-next
