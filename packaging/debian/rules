#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-2.0-only

include /usr/share/dpkg/pkg-info.mk

# The plugin is built for the OpenRGB this release has, when we pin that
# one: 1.0 with Qt 5, as Debian has it, or 1.1 with Qt 6. Full then depends
# on the plugin. Ubuntu's own OpenRGB is a snapshot from before 1.0. There
# the plugin is built for OpenRGB 1.1 from openrgb.org, whose trixie
# package runs on Ubuntu's own Qt 6, and Full only recommends it. Any other
# OpenRGB stops the build: it needs a new pin in integrations/openrgb/PIN.
OPENRGB := $(shell apt-cache show --no-all-versions openrgb 2>/dev/null | sed -n 's/^Version: //p')
OPENRGB_LIB := $(shell apt-cache show --no-all-versions openrgb 2>/dev/null | grep -o 'libqt[56]' | head -n 1)
OPENRGB_SERIES := $(shell echo '$(OPENRGB)' | sed -n 's/^\([0-9]*\.[0-9]*\).*/\1/p')
PLUGIN := hyperflux-next-v2-openrgb-plugin (= $(DEB_VERSION))
ifeq ($(OPENRGB),)
$(error apt doesn't know this release's openrgb package; run apt-get update first)
else ifeq ($(OPENRGB_SERIES) $(OPENRGB_LIB),1.0 libqt5)
QT := 5
RELATIONS := -V'hfx:OpenRGB=openrgb (>= 1.0), openrgb (<< 1.1~)' -V'hfx:Full-Depends=$(PLUGIN)'
else ifeq ($(OPENRGB_SERIES) $(OPENRGB_LIB),1.1 libqt6)
QT := 6
RELATIONS := -V'hfx:OpenRGB=openrgb (>= 1.1), openrgb (<< 1.2~)' -V'hfx:Full-Depends=$(PLUGIN)'
else ifeq ($(shell dpkg --compare-versions '$(OPENRGB)' lt 1.0~ && echo older),older)
QT := 6
RELATIONS := -V'hfx:OpenRGB=openrgb (>= 1.1), openrgb (<< 1.2~)' -V'hfx:Full-Recommends=$(PLUGIN)'
else
$(error OpenRGB $(OPENRGB) ($(OPENRGB_LIB)) has no pinned tree to build the plugin against)
endif

HFX_MAKE := $(MAKE) OPENRAZER_GROUP=plugdev OPENRGB_QT=$(QT)

%:
	dh $@

override_dh_auto_build:
	$(HFX_MAKE) rust openrazer-tree crate-notices openrgb-plugin

# The Rust, Python and C++ tests run in CI before anything is packaged.
override_dh_auto_test:

override_dh_auto_install:
	$(HFX_MAKE) DESTDIR=$(CURDIR)/debian/hyperflux-next-v2-linux install-linux
	$(HFX_MAKE) DESTDIR=$(CURDIR)/debian/hyperflux-next-v2-openrazer-driver-dkms install-openrazer-dkms
	$(HFX_MAKE) DESTDIR=$(CURDIR)/debian/hyperflux-next-v2-full install-full
	$(HFX_MAKE) DESTDIR=$(CURDIR)/debian/hyperflux-next-v2-openrgb-plugin install-openrgb-plugin

override_dh_gencontrol:
	dh_gencontrol -- $(RELATIONS)

override_dh_installdocs:
	dh_installdocs
	dh_installdocs -phyperflux-next-v2-linux target/LICENSE-rust-crates

# Nothing is enabled, started, stopped or restarted on install or upgrade.
# The install guides tell people which units to enable.
override_dh_installsystemd:
	dh_installsystemd -phyperflux-next-v2-linux --no-enable --no-start --no-stop-on-upgrade \
		hyperflux-next-bridge.service hyperflux-next-keeper.service

# cargo already strips the Rust binaries; dwz has nothing to work on.
override_dh_dwz:
