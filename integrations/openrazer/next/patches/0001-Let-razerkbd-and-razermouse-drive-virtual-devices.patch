Let razerkbd and razermouse drive virtual devices

Some Razer devices can only be reached through something else, such as a
receiver that several devices share (OpenRazer issue 1892, and the
HyperFlux V2 receiver, 1532:00CF). This lets a program that knows such a
receiver present each device behind it as a uhid device, which razerkbd
and razermouse then drive with the code they have for its model. The
daemon, Polychromatic and the Python library see an ordinary device, and
the drivers gain no receiver code and no new ids.

A virtual device is bound only if it is on BUS_VIRTUAL with Razer's
vendor id, its phys is "openrazer-virtual/v1/" followed by lower-case
letters, digits and '-', its report descriptor is exactly the one in
razercommon.c (one 90-byte feature report, no input reports), and its
product id is one the driver lists for USB. Each report goes to it as a
feature SET_REPORT and then a feature GET_REPORT, report 0, with the 90
bytes as they are. The program answers the GET with the device's
response, or fails it. A failed GET is final: the driver neither asks
again nor logs it, since the program has tried what it could and says
why itself.

With no input reports, the event, raw event and input code never runs
for a virtual device. The other USB-only parts are skipped: razerkbd's
key state per USB device, autosuspend, the device mode razerkbd sets at
bind (the program puts its device in the mode it needs), and the
DeathAdder 3.5G's own reports, which get -ENODEV. Whether a device is on
USB is asked with hid_is_usb(), so a uhid device that says BUS_USB isn't
taken for one.

razerkbd and razermouse show the prefix in the read-only parameter
virtual_phys, for a program to check before it creates a device. Setting
it is refused. 99-razer.rules gets two bind rules for virtual devices,
because the existing rules match on USB attributes.

This is the patch proposed to OpenRazer. HyperFlux Next V2 carries it
until a release has it.

Applies to OpenRazer master (f5d547093d30fb2efa9c57469a1a30a0a1a279a5).

diff --git a/driver/razercommon.c b/driver/razercommon.c
index fd6e828..ee6449d 100644
--- a/driver/razercommon.c
+++ b/driver/razercommon.c
@@ -9,9 +9,141 @@
 #include <linux/module.h>
 #include <linux/init.h>
 #include <linux/hid.h>
+#include <linux/ctype.h>
 
 #include "razercommon.h"
 
+/*
+ * Virtual devices
+ *
+ * A program that reaches a Razer device by some other way than its own USB
+ * interface, for example through a receiver that several devices share, can
+ * present it as a uhid device. razerkbd and razermouse bind such a device and
+ * send it the same 90-byte reports they send over USB: each one as a feature
+ * SET_REPORT followed by a feature GET_REPORT, report number 0, with the 90
+ * bytes as they are. The program answers the GET with the device's response,
+ * or fails it.
+ *
+ * Only whoever can write /dev/uhid can create such a device, by default root.
+ * The checks below don't make a device trustworthy. They keep the drivers to
+ * devices that were made for them: on the virtual bus, with Razer's vendor id,
+ * this phys prefix and exactly this report descriptor, and with a product id
+ * the driver already lists for USB. The descriptor has one feature report and
+ * no input reports, so the drivers' event and input code, which expects a USB
+ * device, never runs for a virtual device.
+ */
+#define RAZER_VIRTUAL_PHYS_PREFIX "openrazer-virtual/v1/"
+
+static const u8 razer_virtual_rdesc[] = {
+    0x06, 0x00, 0xff,   /* Usage Page (Vendor Defined 0xff00) */
+    0x09, 0x01,         /* Usage (1) */
+    0xa1, 0x01,         /* Collection (Application) */
+    0x15, 0x00,         /*   Logical Minimum (0) */
+    0x26, 0xff, 0x00,   /*   Logical Maximum (255) */
+    0x75, 0x08,         /*   Report Size (8) */
+    0x95, 0x5a,         /*   Report Count (90) */
+    0xb1, 0x02,         /*   Feature (Data, Var, Abs) */
+    0xc0,               /* End Collection */
+};
+
+static bool razer_is_virtual_device(struct hid_device *hdev)
+{
+    size_t prefix_len = strlen(RAZER_VIRTUAL_PHYS_PREFIX);
+    const char *label = hdev->phys + prefix_len;
+
+    if (hdev->bus != BUS_VIRTUAL || hdev->vendor != USB_VENDOR_ID_RAZER ||
+        strncmp(hdev->phys, RAZER_VIRTUAL_PHYS_PREFIX, prefix_len) ||
+        hdev->dev_rsize != sizeof(razer_virtual_rdesc) ||
+        memcmp(hdev->dev_rdesc, razer_virtual_rdesc, sizeof(razer_virtual_rdesc)))
+        return false;
+
+    /* The rest of phys names the device: lower-case letters, digits and '-' */
+    if (!*label)
+        return false;
+    for (; *label; label++) {
+        if (!islower(*label) && !isdigit(*label) && *label != '-')
+            return false;
+    }
+    return true;
+}
+
+/**
+ * Whether the driver being probed may take this device
+ *
+ * USB devices are matched by the driver's table as before. A virtual device
+ * has to pass the checks above, and the table matches it with an entry for
+ * any Razer product, so its product id also has to be one the driver lists
+ * for USB. The entry adds a way to reach devices, but no devices.
+ */
+static int razer_virtual_phys_get(char *buf, const struct kernel_param *kp)
+{
+    return scnprintf(buf, PAGE_SIZE, "%s\n", RAZER_VIRTUAL_PHYS_PREFIX);
+}
+
+static int razer_virtual_phys_set(const char *val, const struct kernel_param *kp)
+{
+    return -EPERM;
+}
+
+/*
+ * The parameter virtual_phys of razerkbd and razermouse: the phys prefix of
+ * the virtual devices the loaded module takes, for a program to read from
+ * /sys/module before it creates one. It can't be set.
+ */
+const struct kernel_param_ops razer_virtual_phys_ops = {
+    .get = razer_virtual_phys_get,
+    .set = razer_virtual_phys_set,
+};
+
+bool razer_can_bind(struct hid_device *hdev)
+{
+    const struct hid_device_id *id;
+
+    if (hid_is_usb(hdev))
+        return true;
+    if (!razer_is_virtual_device(hdev))
+        return false;
+    for (id = hdev->driver->id_table; id->bus; id++) {
+        if (id->bus == BUS_USB && id->vendor == hdev->vendor && id->product == hdev->product)
+            return true;
+    }
+    return false;
+}
+
+/**
+ * Send a report to a virtual device and read its response
+ *
+ * There's no wait between the two: the program holds the GET until it has
+ * the response. uhid turns a failed GET into -EIO.
+ */
+static int razer_virtual_exchange(struct hid_device *hdev, const void *request, struct razer_report *response)
+{
+    u8 *buf;
+    int len;
+
+    buf = kmemdup(request, sizeof(struct razer_report), GFP_KERNEL);
+    if (!buf)
+        return -ENOMEM;
+
+    len = hid_hw_raw_request(hdev, 0, buf, sizeof(struct razer_report),
+                             HID_FEATURE_REPORT, HID_REQ_SET_REPORT);
+    if (len == sizeof(struct razer_report)) {
+        memset(buf, 0, sizeof(struct razer_report));
+        len = hid_hw_raw_request(hdev, 0, buf, sizeof(struct razer_report),
+                                 HID_FEATURE_REPORT, HID_REQ_GET_REPORT);
+    }
+    if (len == sizeof(struct razer_report) && response)
+        memcpy(response, buf, sizeof(struct razer_report));
+    kfree(buf);
+
+    /* The program behind the device logs why, so this doesn't */
+    if (len < 0) {
+        hid_dbg(hdev, "Failed to exchange report with virtual device: %d\n", len);
+        return len;
+    }
+    return len == sizeof(struct razer_report) ? 0 : -EIO;
+}
