+     */
+    if (!hid_is_usb(hdev)) {
+        err = razer_virtual_exchange(hdev, request_report, response_report);
+        if (!err && response_report->data_size > ARRAY_SIZE(response_report->arguments)) {
+            response_report->data_size = ARRAY_SIZE(response_report->arguments);
+            err = -EINVAL;
+        }
+        return err;
+    }
+
+    usb_dev = hid_to_usb_dev(hdev);
+
     // Send the request to the device.
     err = razer_send_control_msg(hdev, request_report, sizeof(*request_report), report_index, wait);
     if (err)
@@ -163,9 +319,15 @@ void print_erroneous_report(struct hid_device *hdev, struct razer_report* report
 
