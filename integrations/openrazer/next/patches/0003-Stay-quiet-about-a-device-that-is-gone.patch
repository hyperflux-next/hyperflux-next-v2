         return err;
     }
 
@@ -343,7 +345,7 @@ int razer_send_control_msg_old_device(struct hid_device *hdev, const void *data,
     // Wait
     fsleep(wait);
 
-    if (ret)
+    if (ret && ret != -ENODEV)
         hid_warn(hdev, "Failed to send USB control message: %d\n", ret);
 
     return ret;
@@ -387,7 +389,7 @@ int razer_send_argb_msg(struct hid_device* hdev, unsigned char channel, size_t s
                                USB_CTRL_SET_TIMEOUT, // time in msecs to wait for the message to complete before timing out
                                GFP_KERNEL);
 
-    if (ret)
