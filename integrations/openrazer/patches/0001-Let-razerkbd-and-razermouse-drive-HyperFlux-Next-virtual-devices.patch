+# HyperFlux Next virtual devices have no USB parent, so the rules below never
+# match them. Give their attributes to the OpenRazer group once the driver binds.
+ACTION=="bind", SUBSYSTEM=="hid", KERNEL=="0006:1532:*", ENV{HID_PHYS}=="hyperflux-next/native/v1/*", DRIVER=="razerkbd", RUN+="razer_mount razerkbd $kernel"
+ACTION=="bind", SUBSYSTEM=="hid", KERNEL=="0006:1532:*", ENV{HID_PHYS}=="hyperflux-next/native/v1/*", DRIVER=="razermouse", RUN+="razer_mount razermouse $kernel"
 ACTION!="add", GOTO="razer_end"
 SUBSYSTEMS=="usb|input|hid", ATTRS{idVendor}=="1532", GOTO="razer_vendor"
 GOTO="razer_end"
