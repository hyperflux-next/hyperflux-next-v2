@@ -291,3 +295,129 @@ int razer_send_argb_msg(struct usb_device* usb_dev, unsigned char channel, unsig
 
     return ((len < 0) ? len : ((len != size) ? -EIO : 0));
 }
+
+/*
+ * HyperFlux Next virtual devices
+ *
+ * HyperFlux Next creates a uhid device for each wireless Razer device paired
+ * to a HyperFlux V2 receiver and carries its 90-byte feature reports through
+ * the receiver. razerkbd and razermouse bind it as if it were the wireless
+ * device's own USB control interface and exchange each report with a
+ * feature SET followed by a feature GET.
+ *
+ * HyperFlux Next's udev rules give /dev/uhid to the hyperflux-keeper group,
+ * which only its device keeper is in, so a virtual-bus device with this phys
+ * prefix and this exact report descriptor came from HyperFlux Next. It has
+ * one feature report and no input reports, so the drivers' raw_event and
+ * input code, which expect a USB parent, never run for such a device.
+ */
+#define RAZER_HYPERFLUX_PHYS_PREFIX "hyperflux-next/native/v1/"
+
+static const u8 razer_hyperflux_rdesc[] = {
+    0x06, 0x00, 0xff, /* Usage Page (0xff00) */
+    0x09, 0x01, /* Usage (1) */
+    0xa1, 0x01, /* Collection (Application) */
+    0x15, 0x00, /* Logical Minimum (0) */
+    0x26, 0xff, 0x00, /* Logical Maximum (255) */
+    0x75, 0x08, /* Report Size (8) */
+    0x95, 0x5a, /* Report Count (90) */
+    0xb1, 0x02, /* Feature (Data, Var, Abs) */
+    0xc0, /* End Collection */
+};
+
+static bool razer_is_hyperflux(struct hid_device *hdev)
+{
+    size_t prefix_len = strlen(RAZER_HYPERFLUX_PHYS_PREFIX);
+    const char *label = hdev->phys + prefix_len;
+
+    if (hdev->bus != BUS_VIRTUAL || hdev->vendor != USB_VENDOR_ID_RAZER ||
+        strncmp(hdev->phys, RAZER_HYPERFLUX_PHYS_PREFIX, prefix_len) ||
+        hdev->dev_rsize != sizeof(razer_hyperflux_rdesc) ||
+        memcmp(hdev->dev_rdesc, razer_hyperflux_rdesc, sizeof(razer_hyperflux_rdesc)))
+        return false;
+
+    if (!*label)
+        return false;
+    for (; *label; label++) {
+        if ((*label < 'a' || *label > 'z') && (*label < '0' || *label > '9') && *label != '-')
+            return false;
+    }
+    return true;
+}
+
+/*
+ * razerkbd and razermouse list one virtual-bus entry that matches any Razer
+ * product. Bind a HyperFlux device only if the driver already lists its
+ * product id for USB, so the entry adds a transport but no devices.
+ * hdev->driver is the driver being probed.
+ */
+bool razer_can_bind(struct hid_device *hdev)
+{
+    const struct hid_device_id *id;
+
+    if (hdev->bus == BUS_USB)
+        return true;
+    if (!razer_is_hyperflux(hdev))
+        return false;
+    for (id = hdev->driver->id_table; id->bus; id++) {
+        if (id->bus == BUS_USB && id->vendor == hdev->vendor && id->product == hdev->product)
+            return true;
+    }
+    return false;
+}
+
+/*
+ * When the bridge has no response to give, it still answers the GET, with
+ * "HFXNERR1", version 1, the kind of failure, zeros and 0x5a 0xa5, because
+ * uhid turns every GET error into EIO and userspace should know whether the
+ * report may have reached the device.
+ */
+static int razer_hyperflux_error(const struct razer_report *report)
+{
+    const u8 *bytes = (const u8 *)report;
+
+    if (memcmp(bytes, "HFXNERR1", 8) || bytes[8] != 1 ||
+        memchr_inv(bytes + 10, 0, 78) || bytes[88] != 0x5a || bytes[89] != 0xa5)
+        return 0;
+
+    switch (bytes[9]) {
+    case 1:
+        return RAZER_HYPERFLUX_NOT_SENT;
+    case 2:
+        return RAZER_HYPERFLUX_MAY_HAVE_BEEN_SENT;
+    }
+    return 0;
+}
+
+/*
+ * No sleep between SET and GET: the bridge acknowledges the SET straight
+ * away and holds the GET until the receiver has answered. uhid reports a
+ * refused SET and a timed-out one alike, so any failure here may have
+ * reached the device.
+ */
+int razer_hyperflux_get_report(struct hid_device *hdev, struct razer_report *request, struct razer_report *response)
+{
+    int len, err;
+
+    len = hid_hw_raw_request(hdev, 0, (u8 *)request, RAZER_USB_REPORT_LEN,
+                             HID_FEATURE_REPORT, HID_REQ_SET_REPORT);
+    if (len != RAZER_USB_REPORT_LEN)
+        return RAZER_HYPERFLUX_MAY_HAVE_BEEN_SENT;
+
+    memset(response, 0, sizeof(*response));
+    len = hid_hw_raw_request(hdev, 0, (u8 *)response, RAZER_USB_REPORT_LEN,
+                             HID_FEATURE_REPORT, HID_REQ_GET_REPORT);
+    if (len != RAZER_USB_REPORT_LEN)
+        return RAZER_HYPERFLUX_MAY_HAVE_BEEN_SENT;
+
+    err = razer_hyperflux_error(response);
+    if (err)
+        return err;
+
+    // As in razer_get_usb_response(): some callers use data_size as a length
+    if (response->data_size > ARRAY_SIZE(response->arguments)) {
+        response->data_size = ARRAY_SIZE(response->arguments);
+        return RAZER_HYPERFLUX_MAY_HAVE_BEEN_SENT;
+    }
+    return 0;
+}
