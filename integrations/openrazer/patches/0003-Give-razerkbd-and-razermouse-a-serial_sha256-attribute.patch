Give razerkbd and razermouse a serial_sha256 attribute

hyperflux-next-bridge leaves out its virtual device while a wired device
of the same model is plugged in, since that is usually the same unit on
its cable. It can't tell a second unit apart: device_serial is readable
only by OpenRazer's group, and the bridge runs as a system user outside
it.

serial_sha256 holds the SHA-256 of the serial that device_serial shows,
as 64 lowercase hex digits, and anyone may read it. NUL and white space
at both ends are trimmed first, as the bridge trims the serial it reads
through the receiver, so the same serial gives the same hash on both
sides. An empty serial, or one with anything but printable ASCII left,
has none, and reading fails with ENODATA.

The first read asks the device, and later reads get the kept hash. The
bridge reads the file whenever a HID device comes or goes, including
while the cable is being pulled. A read that waits on a device being
removed holds up the removal: on 2026-11-23 one died in the kernel, and
the USB hub's worker waited for it from then on. A device that is going
away isn't asked. One that didn't answer is asked again after ten
seconds at the earliest.

Only USB devices get it: not the virtual devices, and not Blade laptops,
whose serial comes from DMI and only root may read.

Serials are short and follow a pattern, so trying candidates against the
hash would find one. The hash keeps the serial out of plain sight; it
doesn't make it secret.

Applies to OpenRazer 3.12.5 (f7626d0003e03a43f7ea8b449140c81426dc3eb2)
after 0001 and 0002.

diff --git a/driver/razercommon.c b/driver/razercommon.c
index 82b58e6..1f07618 100644
--- a/driver/razercommon.c
+++ b/driver/razercommon.c
@@ -424,3 +424,85 @@ int razer_hyperflux_get_report(struct hid_device *hdev, struct razer_report *req
     }
     return 0;
 }
+
+/*
+ * serial_sha256 for hyperflux-next-bridge, which can't read device_serial
+ * (only OpenRazer's group may) and only needs to know whether a wired
+ * device is the unit it reaches through the receiver. serial holds len
+ * bytes that device_serial's show function wrote; their hash goes to out
+ * in hex, with a newline. NUL and white space at both ends go first,
+ * exactly as the bridge trims the serial it reads, and a serial that is
+ * then empty or has anything but printable ASCII gets no hash.
+ *
+ * The hash is over a fixed label and the trimmed serial, so it equals the
+ * fingerprint the bridge makes from the serial it reads through the
+ * receiver and the two can be compared. The label keeps this value from
+ * doubling as a hash of the serial on its own.
+ */
+#define RAZER_SERIAL_HASH_LABEL "hyperflux-next serial"
+
+static bool razer_serial_trim(char c)
+{
+    return !c || c == ' ' || c == '\t' || c == '\n' || c == '\f' || c == '\r';
+}
+
+static ssize_t razer_serial_sha256(char *out, size_t size, const char *serial, ssize_t len)
+{
+    /* The label with its NUL, then the longest serial either driver reads. */
+    u8 message[sizeof(RAZER_SERIAL_HASH_LABEL) + 64];
+    u8 digest[SHA256_DIGEST_SIZE];
+    ssize_t start = 0, end = len, i;
+    size_t label = sizeof(RAZER_SERIAL_HASH_LABEL);
+
+    while (start < end && razer_serial_trim(serial[start]))
+        start++;
+    while (end > start && razer_serial_trim(serial[end - 1]))
+        end--;
+    if (start == end || (size_t)(end - start) > sizeof(message) - label)
+        return -ENODATA;
+    for (i = start; i < end; i++) {
+        if ((unsigned char)serial[i] < 0x21 || (unsigned char)serial[i] > 0x7e)
+            return -ENODATA;
+    }
+    memcpy(message, RAZER_SERIAL_HASH_LABEL, label);
+    memcpy(message + label, serial + start, end - start);
+    sha256(message, label + (end - start), digest);
+    return scnprintf(out, size, "%*phN\n", SHA256_DIGEST_SIZE, digest);
+}
+
+/*
+ * The show function of serial_sha256. The serial is read from the device
+ * once and its hash kept, so later reads never reach the device. The
+ * bridge reads the file whenever a HID device comes or goes, which
+ * includes the moment the cable is pulled, and a read that waits on a
+ * device being removed holds up that removal. A device that is going away
+ * isn't asked at all, and one that didn't answer is asked again ten
+ * seconds later at the earliest, so a reader doesn't sit out the USB
+ * timeouts on every read.
+ */
+ssize_t razer_serial_hash_show(struct razer_serial_hash *hash, struct usb_device *usb_dev,
+                               struct device *dev, char *buf, razer_show_fn read_serial)
+{
+    char hex[sizeof(hash->hex)];
+    unsigned long tried = READ_ONCE(hash->tried);
+    ssize_t len;
+
+    if (smp_load_acquire(&hash->valid))
+        return sysfs_emit(buf, "%s", hash->hex);
+    if (READ_ONCE(usb_dev->state) != USB_STATE_CONFIGURED)
+        return -ENODEV;
+    if (tried && time_before(jiffies, tried + 10 * HZ))
+        return -ENODATA;
+
+    len = read_serial(dev, NULL, buf);
+    if (len > 0)
+        len = razer_serial_sha256(hex, sizeof(hex), buf, len);
+    if (len <= 0) {
+        WRITE_ONCE(hash->tried, jiffies | 1);
+        return len < 0 ? len : -ENODATA;
+    }
+    /* Two first reads at once write the same bytes. */
+    memcpy(hash->hex, hex, sizeof(hex));
+    smp_store_release(&hash->valid, true);
+    return sysfs_emit(buf, "%s", hash->hex);
+}
diff --git a/driver/razercommon.h b/driver/razercommon.h
index c11f7fd..e9a3f0b 100644
--- a/driver/razercommon.h
+++ b/driver/razercommon.h
@@ -8,6 +8,7 @@
 #define DRIVER_RAZERCOMMON_H_
 
 #include <linux/usb/input.h>
+#include <crypto/sha2.h>
 
 #define DRIVER_VERSION "3.12.5"
 #define DRIVER_LICENSE "GPL v2"
@@ -181,6 +182,16 @@ void print_erroneous_report(struct razer_report* report, char* driver_name, char
 bool razer_can_bind(struct hid_device *hdev);
 int razer_hyperflux_get_report(struct hid_device *hdev, struct razer_report *request, struct razer_report *response);
 
+/* serial_sha256's hash, read from the device once and kept. Zeroed with the device. */
+struct razer_serial_hash {
+    unsigned long tried; /* jiffies of the last read that failed, 0 before one */
+    bool valid;
+    char hex[SHA256_DIGEST_SIZE * 2 + 2]; /* the digits, a newline and a NUL */
+};
+typedef ssize_t (*razer_show_fn)(struct device *dev, struct device_attribute *attr, char *buf);
+ssize_t razer_serial_hash_show(struct razer_serial_hash *hash, struct usb_device *usb_dev,
+                               struct device *dev, char *buf, razer_show_fn read_serial);
+
 // Convenience functions
 unsigned char clamp_u8(unsigned char value, unsigned char min, unsigned char max);
 unsigned short clamp_u16(unsigned short value, unsigned short min, unsigned short max);
