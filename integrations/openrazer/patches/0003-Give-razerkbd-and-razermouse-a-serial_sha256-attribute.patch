+/**
+ * Read device file "serial_sha256"
+ *
+ * Returns the SHA-256 of the serial number, as hex
+ */
+static ssize_t razer_attr_read_serial_sha256(struct device *dev, struct device_attribute *attr, char *buf)
+{
+    ssize_t len = razer_attr_read_device_serial(dev, attr, buf);
